# Copy to .env and fill in your values (never commit .env)
# Run: npm run start  — or see package.json for other commands

# Required for daily check-in (one line per account)
COOKIE=ltuid_v2=YOUR_LTUID; ltoken_v2=YOUR_LTOKEN

# Required for check-in; include gi to enable Genshin redemption
GAMES=gi zzz hsr

# Optional — Genshin gift-page cookies (one line per account)
# GIFT_COOKIE=account_id_v2=...; account_mid_v2=...; cookie_token_v2=...

# Optional — Discord notifications
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# DISCORD_USER=

# Local dev: skip Discord webhook (recommended while testing)
SKIP_DISCORD=1

# Local dev: separate state file so Actions state is untouched
REDEEM_STATE_PATH=redeem-state.local.json

# Preview check-in and redemption without API calls or state changes
# DRY_RUN=1
